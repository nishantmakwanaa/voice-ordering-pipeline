# Application
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=false
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# Database
DATABASE_URL=postgresql+asyncpg://voiceserve:voiceserve@localhost:5432/voiceserve
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_TTL_MENU=3600
REDIS_TTL_SESSION=1800
REDIS_TTL_RECOMMENDATIONS=900

# Saaras v3 STT
SAARAS_API_KEY=your-saaras-api-key
SAARAS_API_URL=https://api.saaras.ai/v3
SAARAS_LANGUAGE=en-IN
SAARAS_SAMPLE_RATE=16000
SAARAS_NOISE_THRESHOLD=0.02

# Kimi K2 LLM
KIMI_API_KEY=your-kimi-api-key
KIMI_API_URL=https://api.moonshot.cn/v1
KIMI_MODEL=kimi-k2-instruct
KIMI_MAX_TOKENS=1024
KIMI_TEMPERATURE=0.3
KIMI_CONTEXT_WINDOW=32768

# Bulbul v3 TTS
BULBUL_API_KEY=your-bulbul-api-key
BULBUL_API_URL=https://api.bulbul.ai/v3
BULBUL_VOICE=female_1
BULBUL_LANGUAGE=en-IN
BULBUL_SPEED=1.0
BULBUL_FORMAT=pcm_16000

# Pinecone
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_ENVIRONMENT=us-east-1-aws
PINECONE_INDEX_NAME=voiceserve-menu
PINECONE_DIMENSION=1536
PINECONE_METRIC=cosine

# Gemini (for reporting)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-1.5-pro

# FP-Growth
FPGROWTH_MIN_SUPPORT=0.05
FPGROWTH_MIN_CONFIDENCE=0.3
FPGROWTH_MAX_RECOMMENDATIONS=5
